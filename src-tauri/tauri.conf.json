{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARCO",
  "version": "0.1.0",
  "identifier": "com.arco.design",
  "build": {
    "frontendDist": "..",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "python3 -m http.server 8080 --bind 127.0.0.1",
    "beforeBuildCommand": "python3 -c \"print('ARCO static frontend: ready')\""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ARCO — Design Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "perUser",
        "displayLanguageSelector": false,
        "allowDowngrades": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
